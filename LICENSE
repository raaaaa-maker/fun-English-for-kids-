  {
    question: "What color is the sky?",
    options: ["Blue", "Green", "Red", "Yellow"],
    answer: "Blue",
  },
  {
    question: "Which one is an animal?",
    options: ["Apple", "Dog", "Car", "Chair"],
    answer: "Dog",
